# Serper.dev Google 搜索 API Key（免费 100次/月）
# 注册地址：https://serper.dev/
SERPER_API_KEY=

# Firecrawl 官网发现与正文抓取（推荐配置）
# 注册地址：https://www.firecrawl.dev/
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

# Jina Reader API Key（可选，不配则用直连 fallback）
# 注册地址：https://jina.ai/reader/
JINA_API_KEY=

# Any OpenAI-compatible key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# 设为 false 时，系统仍会生成基于真实来源的基础报告；不会生成假数据。
ENABLE_LLM_ENHANCEMENT=true

# 单次模型请求超时（毫秒）。结构化抽取偶尔较慢，建议 90s 以上；
# completeJson 会在可重试错误（超时/5xx/网络）上自动重试并递增超时阈值。
MODEL_REQUEST_TIMEOUT_MS=90000

# Supabase：兑换码与免费次数（仅服务端使用 service role key）
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Render 仅用这些变量触发 GitHub Actions；不要把模型、搜索或抓取密钥放到 Render。
GITHUB_REPOSITORY=yingxifang73-hue/sales-intel-agent
GITHUB_REF=feat/sales-intelligence-demo
GITHUB_DISPATCH_TOKEN=
# GitHub Actions 未在此时间内接收任务时，页面会结束等待并自动退回本次次数。
RESEARCH_DISPATCH_GRACE_MS=420000

# 采集超时配置（毫秒）
DIRECT_FETCH_TIMEOUT_MS=30000
SEARCH_TIMEOUT_MS=90000
INTERNAL_PAGE_TIMEOUT_MS=20000
